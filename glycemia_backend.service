[Unit]
Description=Glycemia Micro-Backend (Nightscout-compatible)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/glycemia-backend
# Adjust the python path if using a virtualenv:
# ExecStart=/opt/glycemia-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --workers 1
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --workers 1

# --- Security hardening ---
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

# --- Environment ---
# NEVER commit real secrets; override in /etc/systemd/system/glycemia_backend.service.d/override.conf
Environment="API_SECRET=changeme"
Environment="DB_PATH=/opt/glycemia-backend/data/glycemia.db"
Environment="PRUNE_HOURS=48"
Environment="LOG_LEVEL=INFO"

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
