<Window x:Class="XDripWidget.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки xDripWidget"
        Icon="app.ico"
        Width="475"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server URL -->
        <Label Grid.Row="0" Grid.Column="0" Content="Адрес сервера:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServerUrl" Margin="0,4"/>

        <!-- API Secret -->
        <Label Grid.Row="1" Grid.Column="0" Content="API Secret / Токен:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiSecret" Margin="0,4"/>

        <!-- Transparency -->
        <Label Grid.Row="2" Grid.Column="0" Content="Прозрачность (0-70%):" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
            <TextBlock x:Name="LblTransparency" Text="10%" Width="40" VerticalAlignment="Center" Foreground="#F8FAFC"/>
            <Slider x:Name="SliderTransparency" Minimum="0" Maximum="70" Value="10" ValueChanged="SliderTransparency_ValueChanged" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Refresh Interval -->
        <Label Grid.Row="3" Grid.Column="0" Content="Интервал (мин):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtInterval" Text="1" Width="60" HorizontalAlignment="Left" Margin="0,4"/>

        <!-- Treatment Hotkey -->
        <Label Grid.Row="4" Grid.Column="0" Content="Хоткей терапии:" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
            <Button Content="✕" Width="26" Padding="0" Click="BtnClearHotkey_Click" DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="Очистить горячую клавишу"/>
            <TextBox x:Name="TxtHotkey" Text="Ctrl+Alt+D" IsReadOnly="True" PreviewKeyDown="TxtHotkey_PreviewKeyDown" Cursor="Hand" ToolTip="Кликните и нажмите комбинацию клавиш (например, Ctrl+Alt+D)"/>
        </DockPanel>

        <!-- Normal Thresholds -->
        <Label Grid.Row="5" Grid.Column="0" Content="Пороги нормы:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
            <Label Content="Низ:" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtLow" Width="44" Text="3.9" Margin="0,0,14,0" ToolTip="Нижний порог целевого диапазона (ммоль/л)"/>
            <Label Content="Верх:" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtHigh" Width="44" Text="10.0" ToolTip="Верхний порог целевого диапазона (ммоль/л)"/>
        </StackPanel>

        <!-- Urgent Thresholds -->
        <Label Grid.Row="6" Grid.Column="0" Content="Критич. пороги:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
            <Label Content="Крит. низ:" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUrgentLow" Width="44" Text="3.0" Margin="0,0,14,0" ToolTip="Порог глубокой гипогликемии (ммоль/л)"/>
            <Label Content="Крит. верх:" Padding="0,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUrgentHigh" Width="44" Text="14.0" ToolTip="Порог критической гипергликемии (ммоль/л)"/>
        </StackPanel>

        <!-- Sound Alerts Enabled -->
        <Label Grid.Row="7" Grid.Column="0" Content="Звуковые тревоги:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="ChkSound" Content="Включить звуковые сигналы" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,4"/>

        <!-- Low Alert Sound -->
        <Label Grid.Row="8" Grid.Column="0" Content="Сигнал при гипо:" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,3" IsEnabled="{Binding ElementName=ChkSound, Path=IsChecked}">
            <Button x:Name="BtnPlaySoundLow" Content="▶" Width="28" Padding="0" Click="BtnPlaySoundLow_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Прослушать сигнал"/>
            <Button x:Name="BtnBrowseSoundLow" Content="📁" Width="28" Padding="0" Click="BtnBrowseSoundLow_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Выбрать аудиофайл (mp3, wav, m4a...)"/>
            <ComboBox x:Name="CmbSoundLow"/>
        </DockPanel>

        <!-- High Alert Sound -->
        <Label Grid.Row="9" Grid.Column="0" Content="Сигнал при гипер:" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,3" IsEnabled="{Binding ElementName=ChkSound, Path=IsChecked}">
            <Button x:Name="BtnPlaySoundHigh" Content="▶" Width="28" Padding="0" Click="BtnPlaySoundHigh_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Прослушать сигнал"/>
            <Button x:Name="BtnBrowseSoundHigh" Content="📁" Width="28" Padding="0" Click="BtnBrowseSoundHigh_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Выбрать аудиофайл (mp3, wav, m4a...)"/>
            <ComboBox x:Name="CmbSoundHigh"/>
        </DockPanel>

        <!-- Drop Alert Sound -->
        <Label Grid.Row="10" Grid.Column="0" Content="Сигнал при спаде:" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,3" IsEnabled="{Binding ElementName=ChkSound, Path=IsChecked}">
            <Button x:Name="BtnPlaySoundDrop" Content="▶" Width="28" Padding="0" Click="BtnPlaySoundDrop_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Прослушать сигнал"/>
            <Button x:Name="BtnBrowseSoundDrop" Content="📁" Width="28" Padding="0" Click="BtnBrowseSoundDrop_Click" DockPanel.Dock="Right" Margin="4,0,0,0" ToolTip="Выбрать аудиофайл (mp3, wav, m4a...)"/>
            <ComboBox x:Name="CmbSoundDrop"/>
        </DockPanel>

        <!-- Visual Alerts -->
        <Label Grid.Row="11" Grid.Column="0" Content="Визуальная тревога:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="11" Grid.Column="1" x:Name="ChkVisual" Content="Пульсация рамки при тревоге" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,6,0,4"/>

        <!-- Run on Startup -->
        <Label Grid.Row="12" Grid.Column="0" Content="Автозапуск:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="12" Grid.Column="1" x:Name="ChkStartup" Content="Запускать при старте Windows" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,6,0,4"/>

        <!-- Acrylic Blur -->
        <Label Grid.Row="13" Grid.Column="0" Content="Эффект стекла:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="13" Grid.Column="1" x:Name="ChkAcrylic" Content="Матовое стекло (Acrylic Blur)" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,6,0,4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,4">
            <Button Content="Сохранить" Click="BtnSave_Click" Background="#0284C7" BorderBrush="#0284C7" Margin="0,0,8,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
