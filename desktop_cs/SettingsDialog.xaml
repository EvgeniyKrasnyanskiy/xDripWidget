<Window x:Class="XDripWidget.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки xDripWidget"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server URL -->
        <Label Grid.Row="0" Grid.Column="0" Content="Адрес сервера:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServerUrl" Margin="0,5"/>

        <!-- API Secret -->
        <Label Grid.Row="1" Grid.Column="0" Content="API Secret / Токен:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiSecret" Margin="0,5"/>

        <!-- Transparency -->
        <Label Grid.Row="2" Grid.Column="0" Content="Прозрачность (0-70%):" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,5">
            <TextBlock x:Name="LblTransparency" Text="10%" Width="40" VerticalAlignment="Center" Foreground="#F8FAFC"/>
            <Slider x:Name="SliderTransparency" Minimum="0" Maximum="70" Value="10" ValueChanged="SliderTransparency_ValueChanged" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Refresh Interval -->
        <Label Grid.Row="3" Grid.Column="0" Content="Интервал (мин):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtInterval" Text="1" Width="60" HorizontalAlignment="Left" Margin="0,5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,4">
            <Button Content="Сохранить" Click="BtnSave_Click" Background="#0284C7" BorderBrush="#0284C7" Margin="0,0,8,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
