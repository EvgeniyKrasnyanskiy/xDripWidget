<Window x:Class="XDripWidget.TreatmentHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История терапий"
        Width="640" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Последние 50 записей терапий с сервера" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,8"/>

        <!-- ListView with Columns -->
        <ListView Grid.Row="1" x:Name="ListTreatments">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Время" Width="130" DisplayMemberBinding="{Binding DateStr}"/>
                    <GridViewColumn Header="Тип" Width="130" DisplayMemberBinding="{Binding EventType}"/>
                    <GridViewColumn Header="Инсулин" Width="70" DisplayMemberBinding="{Binding InsulinStr}"/>
                    <GridViewColumn Header="Углеводы" Width="70" DisplayMemberBinding="{Binding CarbsStr}"/>
                    <GridViewColumn Header="Сахар" Width="70" DisplayMemberBinding="{Binding GlucoseStr}"/>
                    <GridViewColumn Header="Заметка" Width="120" DisplayMemberBinding="{Binding Notes}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Обновить" Click="BtnRefresh_Click" Margin="0,0,8,0"/>
            <Button Content="Удалить выбранную" Click="BtnDelete_Click" Background="#EF4444" BorderBrush="#EF4444" Foreground="#FFFFFF" Margin="0,0,8,0"/>
            <Button Content="Закрыть" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
