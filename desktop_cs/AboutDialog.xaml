<Window x:Class="XDripWidget.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе xDripWidget"
        Icon="app.ico"
        Width="485" Height="465"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M 10,2 C 10,2 3,12 3,16 C 3,19.9 6.1,23 10,23 C 13.9,23 17,19.9 17,16 C 17,12 10,2 10,2 Z"
                      Fill="#EF4444" Width="16" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,2"/>
                <TextBlock Text="xDripWidget (C# .NET Edition)" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Версия 1.9.0 • Размер ~35 КБ" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            <TextBlock Text="Автор: Evgeniy Krasnyanskiy" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#334155" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Клинический консенсус TIR / AGP (6 диапазонов):" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                <TextBlock Text="• &lt; 3.0 ммоль/л — Очень низкий (#EF4444, Красный)" Foreground="#EF4444" Margin="0,2"/>
                <TextBlock Text="• 3.0 – 3.8 ммоль/л — Низкий (#F59E0B, Янтарный)" Foreground="#F59E0B" Margin="0,2"/>
                <TextBlock Text="• 3.9 – 7.8 ммоль/л — Целевой узкий коридор (#4ADE80, Светло-зелёный)" Foreground="#4ADE80" Margin="0,2"/>
                <TextBlock Text="• 7.9 – 10.0 ммоль/л — Целевой стандартный (#10B981, Изумрудный)" Foreground="#10B981" Margin="0,2"/>
                <TextBlock Text="• 10.1 – 13.9 ммоль/л — Высокий (#F59E0B, Янтарный)" Foreground="#F59E0B" Margin="0,2"/>
                <TextBlock Text="• ≥ 14.0 ммоль/л — Очень высокий (#EF4444, Красный)" Foreground="#EF4444" Margin="0,2"/>

                <TextBlock Text="Цвета терапий:" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,12,0,6"/>
                <TextBlock Text="• Инсулин — Action Blue (#0284C7)" Foreground="#38BDF8" Margin="0,2"/>
                <TextBlock Text="• Углеводы — Amber (#F59E0B)" Foreground="#FBBF24" Margin="0,2"/>
                <TextBlock Text="• Замер сахара крови — Emerald (#10B981)" Foreground="#34D399" Margin="0,2"/>
                <TextBlock Text="• Заметки — Purple (#8B5CF6)" Foreground="#A78BFA" Margin="0,2"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="GitHub Репозиторий" Click="BtnGitHub_Click" Margin="0,0,8,0"/>
            <Button Content="Закрыть" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
