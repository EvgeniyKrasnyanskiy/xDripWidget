<Window x:Class="XDripWidget.TreatmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод терапии"
        Icon="app.ico"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Insulin -->
        <Label Grid.Row="0" Grid.Column="0" Content="Инсулин (ЕД):" Foreground="#38BDF8"/>
        <Border Grid.Row="0" Grid.Column="1" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="6" Margin="0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtInsulin" Text=""
                         Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                         FontSize="15" FontWeight="SemiBold" Padding="10,6"
                         VerticalContentAlignment="Center"
                         PreviewMouseWheel="TxtInsulin_MouseWheel"
                         PreviewKeyDown="TxtInsulin_PreviewKeyDown"/>
                <Grid Grid.Column="1" Margin="0,2,3,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="▲" Click="BtnInsulinUp_Click"
                            Style="{StaticResource SpinButtonStyle}"
                            Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,0,1"/>
                    <Button Grid.Row="1" Content="▼" Click="BtnInsulinDown_Click"
                            Style="{StaticResource SpinButtonStyle}"
                            Background="#0284C7" Foreground="#FFFFFF" Margin="0,1,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Carbs -->
        <Label Grid.Row="1" Grid.Column="0" Content="Углеводы (г):" Foreground="#FBBF24"/>
        <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="6" Margin="0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtCarbs" Text=""
                         Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                         FontSize="15" FontWeight="SemiBold" Padding="10,6"
                         VerticalContentAlignment="Center"
                         PreviewMouseWheel="TxtCarbs_MouseWheel"
                         PreviewKeyDown="TxtCarbs_PreviewKeyDown"/>
                <Grid Grid.Column="1" Margin="0,2,3,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="▲" Click="BtnCarbsUp_Click"
                            Style="{StaticResource SpinButtonStyle}"
                            Background="#F59E0B" Foreground="#0F172A" Margin="0,0,0,1"/>
                    <Button Grid.Row="1" Content="▼" Click="BtnCarbsDown_Click"
                            Style="{StaticResource SpinButtonStyle}"
                            Background="#F59E0B" Foreground="#0F172A" Margin="0,1,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Notes -->
        <Label Grid.Row="2" Grid.Column="0" Content="Заметка:" Foreground="#C084FC"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtNotes" BorderBrush="#8B5CF6" BorderThickness="1.5" Margin="0,6" FontWeight="Normal" FontSize="14"/>

        <!-- Date & Time -->
        <Label Grid.Row="3" Grid.Column="0" Content="Время:" Foreground="#94A3B8"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDateTime" BorderBrush="#475569" BorderThickness="1.5" Margin="0,6" FontWeight="Normal" FontSize="13" Foreground="#E2E8F0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,6">
            <Button Content="Отправить" Click="BtnSubmit_Click" Background="#10B981" BorderBrush="#10B981" Foreground="#FFFFFF" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
