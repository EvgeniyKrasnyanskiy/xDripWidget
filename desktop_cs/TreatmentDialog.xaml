<Window x:Class="XDripWidget.TreatmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод данных терапии"
        Width="420" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Event Type -->
        <Label Grid.Row="0" Grid.Column="0" Content="Тип события:"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbEventType" SelectionChanged="CmbEventType_SelectionChanged" Margin="0,4"/>

        <!-- Insulin -->
        <Label Grid.Row="1" Grid.Column="0" Content="Инсулин (ЕД):" Foreground="#38BDF8"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtInsulin" Text="0.0" BorderBrush="#0284C7" BorderThickness="1.5" Margin="0,4"/>

        <!-- Carbs -->
        <Label Grid.Row="2" Grid.Column="0" Content="Углеводы (г):" Foreground="#FBBF24"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCarbs" Text="0.0" BorderBrush="#F59E0B" BorderThickness="1.5" Margin="0,4"/>

        <!-- Blood Glucose -->
        <Label Grid.Row="3" Grid.Column="0" Content="Сахар крови (ммоль):" Foreground="#34D399"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtGlucose" Text="0.0" BorderBrush="#10B981" BorderThickness="1.5" Margin="0,4"/>

        <!-- Notes -->
        <Label Grid.Row="4" Grid.Column="0" Content="Заметка:" Foreground="#A78BFA"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtNotes" BorderBrush="#8B5CF6" BorderThickness="1.5" Margin="0,4"/>

        <!-- Date & Time -->
        <Label Grid.Row="5" Grid.Column="0" Content="Время:"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtDateTime" BorderBrush="#334155" Margin="0,4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отправить" Click="BtnSubmit_Click" Background="#10B981" BorderBrush="#10B981" Foreground="#FFFFFF" Margin="0,0,8,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
